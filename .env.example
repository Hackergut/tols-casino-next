# ─────────────────────────────────────────────────────────────────────────
# TOLS — environment template. Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ──
# From Supabase dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL  = "Transaction" pooler (host ends in ...pooler.supabase.com,
#                 port 6543). Add ?pgbouncer=true. This is what the app uses at
#                 runtime; the pooler keeps serverless functions from exhausting
#                 Postgres connections.
# DIRECT_URL    = "Session"/direct connection (port 5432). Prisma uses this for
#                 migrations only — PgBouncer can't run them.
#
# Replace [PASSWORD] and [PROJECT-REF] with your project's values.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional Redis. When set, the realtime bus (src/lib/realtime.ts) upgrades
# from in-process delivery to Redis pub/sub so SSE events (balance updates,
# bet feed, chat, jackpot) reach players connected to OTHER instances too.
# Required as soon as the app runs on more than one server/serverless region;
# single-instance deployments run fine without it.
# REDIS_URL="redis://localhost:6379"

# ── App ──
# Prendi dominio REALE da Vercel → Settings → Domains
# Casino: https://vercel.com/hackguts-projects/tols-casino-next → es. https://www.tols.fun o https://www.tols.fun
# Governance: https://vercel.com/hackguts-projects/tolsgovernz → es. https://gov.tols.fun
APP_URL="https://www.tols.fun"
# Public origin of the deployment (used for links, Telegram webhook, OG tags).
# In production this must be your real domain, not a tunnel.
APP_URL="https://your-domain.com"

# ── Security (generate with: openssl rand -hex 32) ──
ADMIN_SESSION_SECRET="change-me-32-bytes-hex"
CRON_SECRET="change-me"

# Never enable in production — forces rigged game outcomes.
ALLOW_OUTCOME_CONTROL=false

# ── Telegram bot / Mini App ──
# Setup:  npm run telegram:setup            (read-only: shows current state)
#         npm run telegram:setup -- --apply (registers webhook, commands, menu)
#         npm run telegram:reset            (removes the connection)
#
# Token from @BotFather (/newbot). Revoking a token invalidates the old one
# immediately, which is how you cut a previous deployment loose.
TELEGRAM_BOT_TOKEN=""
# Shared secret sent by Telegram in x-telegram-bot-api-secret-token and
# verified on every webhook call. It is the ONLY proof an update is genuine,
# so the webhook refuses everything when this is unset. Generate with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# Where operational alerts (sign-ups, deposits, withdrawals) are delivered.
# Chat id of a group/channel the bot is an admin of; THREAD_ID is optional and
# only applies to forum-style supergroups.
TELEGRAM_CHAT_ID=""
TELEGRAM_THREAD_ID=""
# Public @handle used by the /support command. Optional.
TELEGRAM_SUPPORT_HANDLE=""
# Credited to new Telegram sign-ups. 0 disables it.
TELEGRAM_WELCOME_BONUS=0
# USDT credited per 1 Telegram Star for in-app top-ups (~$0.013/Star).
STARS_TO_USDT=0.012

# ── TOLS Casino ↔ Governance — 2 PROGETTI VERCEL hackguts-projects ──
# Casino: tols-casino-next | Governance: tolsgovernz
# NON inventare tower.dev.fun / tower.tols.fun — copia i domini da Vercel Domains.
# Su ENTRAMBI i progetti imposta:
#   GOVERNANCE_TOWER_URL = URL reale di tolsgovernz (Vercel → tolsgovernz → Domains)
#   APP_URL              = URL reale di tols-casino-next (Vercel → tols-casino-next → Domains)
#   GOVERNANCE_BRIDGE_SECRET = stesso su entrambi (openssl rand -hex 32)
GOVERNANCE_TOWER_URL="https://gov.tols.fun"
GOVERNANCE_BRIDGE_SECRET="change-me-openssl-rand-hex-32-same-on-both-projects"
# Encrypts runtime-created Governance connections stored in PlatformSetting.
# If omitted, ADMIN_SESSION_SECRET is used. Keep stable across redeploys.
# CONNECTION_ENCRYPTION_KEY="change-me-openssl-rand-hex-32"
# GOVERNANCE_WEBHOOK_SECRET=""  # alias

# ── JWT RS256 Bridge (elimina mockup governance) ──
# PRIVATE su tolsgovernz, PUBLIC su tols-casino-next — coppia da .env.bridge-keys (base64 PEM)
# PLATFORM_JWT_PRIVATE_KEY=""  # solo su tolsgovernz
# PLATFORM_JWT_PUBLIC_KEY=""   # solo su tols-casino-next
# PLATFORM_JWT_ISSUER="tols-governance"
# PLATFORM_JWT_AUDIENCE="tols-casino"

# ── EuroVirtuals (virtual games provider) ──
# ── TOLS Platform API (optional; keys can also be set in admin Settings) ──
TOLS_BASE_URL="https://tolscrypto.base44.app/api"
# TOLS_API_KEY=
# TOLS_APP_KEY=

# ── EuroVirtuals (virtual games provider, seamless-wallet) ──
# Get these from the EuroVirtuals partner dashboard. EV_APP_KEY is the shared
# secret used to sign both launch requests and inbound callbacks — keep it
# out of the browser.
EV_API_BASE="https://api.staging.betkraft.co.uk"
# EV_API_KEY=
# EV_APP_KEY=

# ── Email (optional) ──
# RESEND_API_KEY=

# ── Buy-crypto widget (optional) ──
# ── Deposit chain verification (optional; sane public defaults if unset) ──
# Receive addresses themselves are set in the admin — Deposit Addresses page,
# not here. These only override which RPC/API each chain's verifier calls; the
# defaults (public, free, rate-limited) are fine for low volume and testing.
# Swap in Alchemy/QuickNode/Helius etc. for production volume.
# BTC_API_URL="https://blockstream.info/api"
# ETH_RPC_URL="https://ethereum-rpc.publicnode.com"
# POLYGON_RPC_URL="https://polygon-bor-rpc.publicnode.com"
# BSC_RPC_URL="https://bsc-rpc.publicnode.com"
# SOL_RPC_URL="https://api.mainnet-beta.solana.com"
# USDT_CONTRACT="0xdac17f958d2ee523a2206206994597c13d831ec7"      # USDT, Ethereum ERC-20
# USDC_CONTRACT="0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48"      # USDC, Ethereum ERC-20
# USDT_BEP20_CONTRACT="0x55d398326f99059ff775485246999027b3197955" # USDT, BNB Smart Chain
#
# CRON_SECRET protects /api/cron/watch-deposits, which polls unconfirmed
# deposits and credits them once verified on-chain. Vercel Hobby cron can't run
# more than once/day, so point an external scheduler (cron-job.org etc.) at:
#   GET https://<domain>/api/cron/watch-deposits?secret=<CRON_SECRET>
# every 1-2 minutes for timely crediting.

# ── Email (optional; without a provider, mail is logged in dev only) ──
# RESEND_API_KEY=

# ── Buy-crypto widget (optional; publishable keys, safe for the browser) ──
# NEXT_PUBLIC_BUY_PROVIDER=moonpay
# NEXT_PUBLIC_BUY_API_KEY=
