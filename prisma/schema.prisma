// ==================== CASINO FRONTEND — GAMES & BETTING ====================

model CasinoUser {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  password    String   @default("demo")
  role        String   @default("user")
  status      String   @default("active")
  avatarColor String   @default("#ccff00")
  level       Int      @default(1)
  xp          Int      @default(0)
  dateOfBirth DateTime?
  kycStatus   String   @default("unverified")
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  telegramId  String?  @unique
  emailVerified   DateTime?
  emailVerifyToken String? @unique
  resetToken      String? @unique
  resetExpires    DateTime?
  googleId        String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet      CasinoWallet?
  bets        CasinoBet[]
  deposits    CasinoDeposit[]
  withdrawals CasinoWithdrawal[]
  fairSeeds        FairSeed[]
  starsDeposits    StarsDeposit[]
}

model CasinoWallet {
  id               String     @id @default(cuid())
  userId           String     @unique
  user             CasinoUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance          Float      @default(1000)
  // Bonus money: real value credited by Governance/operators, but locked (not
  // withdrawable) until the wagering requirement is met. `wageringRemaining`
  // is the total stake still to be wagered before the bonus releases.
  bonusBalance      Float      @default(0)
  wageringRemaining Float      @default(0)
  currency         String     @default("USDT")
  vipLevel         Int        @default(1)
  xp               Int        @default(0)
  totalWagered     Float      @default(0)
  totalWon         Float      @default(0)
  depositAddresses String     @default("{}")
  depositIndex     Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model SlotGame {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  provider    String
  category    String   @default("slots")
  image       String   @default("")
  rtp         Float    @default(97)
  volatility  String   @default("medium")
  hasDemo     Boolean  @default(true)
  hasReal     Boolean  @default(true)
  enabled     Boolean  @default(true)
  featured    Boolean  @default(false)
  description String   @default("")
  externalId  String   @default("")
  minBet      Float    @default(0.1)
  maxBet      Float    @default(1000)
  popularity  Int      @default(0)
  launchUrl   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CasinoBet {
  id             String     @id @default(cuid())
  userId         String
  user           CasinoUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId         String
  gameName       String
  gameCategory   String     @default("originals")
  amount         Float
  currency       String     @default("USDT")
  multiplier     Float      @default(0)
  payout         Float      @default(0)
  result         String     @default("lose")
  clientSeed     String     @default("")
  serverSeedHash String     @default("")
  nonce          Int        @default(0)
  payload        String     @default("{}")
  autoBetId      String?
  roundId        String?
  createdAt      DateTime   @default(now())

  @@index([autoBetId])
  @@index([roundId])
}

// In-progress interactive rounds (Crash cashout, Mines reveal, Blackjack actions).
// Secret outcome stays server-side until the round settles.
model GameRound {
  id             String    @id @default(cuid())
  userId         String
  gameId         String
  amount         Float
  status         String    @default("pending") // pending | settled | expired
  clientSeed     String
  serverSeedHash String
  nonce          Int
  secret         String    @default("{}")
  publicState    String    @default("{}")
  multiplier     Float     @default(0)
  payout         Float     @default(0)
  autoBetId      String?
  betId          String?
  startedAt      DateTime  @default(now())
  settledAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, gameId, status])
}

// Auto-bet sessions. Each tick places one server-authoritative wager and
// applies onWin / onLoss / stopLoss / takeProfit before the next round.
model AutoBet {
  id            String   @id @default(cuid())
  userId        String
  gameId        String
  params        String
  status        String   @default("running") // running | stopped | completed | failed
  roundsPlayed  Int      @default(0)
  currentBet    Float
  currentProfit Float    @default(0)
  lastError     String   @default("")
  lastBetId     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, gameId, status])
}

model HouseEarning {
  id          String   @id @default(cuid())
  gameId      String
  gameName    String   @default("")
  betId       String   @default("")
  wager       Float    @default(0)
  payout      Float    @default(0)
  houseProfit Float    @default(0)
  currency    String   @default("USDT")
  createdAt   DateTime @default(now())
}

model GlobalJackpot {
  id                 String    @id @default("global")
  amount             Float     @default(50000)
  currency           String    @default("USDT")
  contributionsCount Int       @default(0)
  lastWinner         String    @default("")
  lastWinAmount      Float     @default(0)
  lastWinDate        DateTime?
  description        String    @default("TOLS Mega Drop — progressive jackpot")
  updatedAt          DateTime  @updatedAt
}

// ==================== CASINO TRANSACTIONS ====================

model CasinoDeposit {
  id           String     @id @default(cuid())
  userId       String
  user         CasinoUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain        String
  txHash       String
  // `amount` is in the CHAIN'S NATIVE UNIT (BTC, ETH, SOL, ...) — what the
  // on-chain verifier matches against the real transferred value. `amountUsd`
  // is what actually gets credited to the (USDT-denominated) wallet. These
  // used to be the same field holding a USD figure, which meant the on-chain
  // amount check could never match for any non-stablecoin chain.
  amount       Float      @default(0)
  amountUsd    Float      @default(0)
  currency     String     @default("USDT")
  fromAddress  String     @default("")
  toAddress    String     @default("")
  status       String     @default("pending")
  credited     Boolean    @default(false)
  referralCode String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([chain, txHash])
}

model CasinoWithdrawal {
  id            String     @id @default(cuid())
  userId        String
  user          CasinoUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String     @default("USDT")
  walletAddress String
  chain         String     @default("solana")
  status        String     @default("pending")
  txHash        String     @default("")
  balanceBefore Float      @default(0)
  balanceAfter  Float      @default(0)
  processedDate DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// ==================== BONUS MONEY / WAGERING ====================
// Bonus grants credited by Governance (or operators). The principal is real
// value but is held as non-withdrawable bonus until `amount * multiplier` has
// been wagered. Wagering progress is aggregated on CasinoWallet.wageringRemaining;
// when it reaches zero, every active credit releases into `balance`.

model BonusCredit {
  id         String    @id @default(cuid())
  userId     String
  amount     Float
  multiplier Float     @default(20) // playthrough: wagered must reach amount * multiplier
  status     String    @default("active") // active | released | forfeited
  source     String    @default("governance") // governance | operator | promo
  reason     String    @default("")
  expiresAt  DateTime?
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status])
}

// ==================== CASINO CHAT ====================

model CasinoChatMessage {
  id          String   @id @default(cuid())
  username    String
  avatarColor String   @default("#ccff00")
  message     String
  channel     String   @default("general")
  createdAt   DateTime @default(now())
}

// ==================== SUPPORT LIVE CHAT ====================
// Player-facing live support, bridged to the Governance Tower. A player opens
// a ticket and their messages are pushed out to Governance
// (`casino.support_message`); agent replies arrive back through the bridge
// webhook (`governance.support_reply`) and are delivered to the player in real
// time over the SSE gateway. `status` tracks the ticket lifecycle.

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String   @default("")
  status    String   @default("open") // open | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String        @default("player") // player | agent
  author    String        @default("")
  content   String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

