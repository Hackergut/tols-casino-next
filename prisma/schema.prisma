// ==================== DEPOSIT ADDRESSES (static, watch-only) ====================
// Public receive addresses pasted from Trust Wallet. The seed NEVER touches the
// server — these are display + watch-only. No private keys are stored anywhere.

model DepositAddress {
  id               String   @id @default(cuid())
  chain            String   @unique // btc | eth | usdt_erc20 | solana | polygon
  label            String   @default("")
  address          String
  memo             String   @default("") // for chains that need a memo/tag
  minConfirmations Int      @default(2)
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

// ==================== RTP / OUTCOME CONTROL (prototype admin rigging) ====================
// Internal testing tool: lets the team force outcomes for specific users/games
// to analyse scenarios. Precedence: user+game > user > game > global.
// This is for a controlled internal prototype, NOT a public money product.

model GameControl {
  id     String  @id @default(cuid())
  label  String  @default("")
  // Scope: which bets this rule applies to.
  scope  String  @default("global") // global | user | game | user_game
  userId String? // set when scope includes a user
  gameId String? // set when scope includes a game (crash, dice, ...)

  // Mode of control.
  mode String @default("normal")
  // normal      — no override (uses fair RNG)
  // force_win   — next bets always win
  // force_lose  — next bets always lose
  // rtp         — bias outcomes toward rtpTarget (0..2, e.g. 0.5 = cold, 1.5 = hot)
  // streak      — force a run of wins then losses (or vice versa) per streakPattern

  rtpTarget        Float  @default(0.99) // target return-to-player when mode = rtp
  winStreak        Int    @default(0) // for mode=streak: number of forced wins…
  loseStreak       Int    @default(0) // …followed by this many forced losses, then repeat
  forcedMultiplier Float? // optional exact multiplier to pay on forced wins

  // Runtime counters (advanced by the bet engine).
  streakPos    Int @default(0) // position within the current streak cycle
  betsAffected Int @default(0)

  enabled   Boolean  @default(true)
  priority  Int      @default(0) // higher wins when multiple rules match
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, userId, gameId, enabled])
}

// Provably-fair seed pairs. The server seed stays secret while the pair is in
// play; `revealedAt` marks it retired, at which point the seed is published so
// every bet made under it can be recomputed and checked against its hash.
model FairSeed {
  id             String     @id @default(cuid())
  userId         String
  user           CasinoUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int        @default(0)
  revealedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([userId, revealedAt])
}

// ==================== TELEGRAM STARS DEPOSITS ====================
// Telegram's in-app wallet (Stars / XTR) top-ups. A pending row is created when
// the player requests a Stars deposit; the invoice payload is the row id, so
// when Telegram POSTs successful_payment to /api/telegram/webhook we can credit
// exactly this deposit, atomically and idempotently.
model StarsDeposit {
  id          String    @id @default(cuid())
  userId      String
  user        CasinoUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  usdtAmount  Float
  starsAmount Int
  payload     String    @unique // invoice payload (= id) used to match the webhook
  invoiceLink String?
  status      String    @default("pending") // pending | paid | failed
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model RedeemCode {
  id        String   @id @default(cuid())
  code      String   @unique
  amount    Float
  currency  String   @default("USDT")
  maxUses   Int      @default(1)
  uses      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==================== VENDOR (external game providers) ====================
// Seamless-wallet ledger. Every debit/credit/rollback a vendor requests is
// recorded here; the @@unique([vendor, externalTxId]) makes replays idempotent
// (a retried callback returns the stored result instead of paying twice).
model VendorTxn {
  id           String   @id @default(cuid())
  vendor       String
  externalTxId String
  roundId      String?
  userId       String
  type         String   // "bet" | "win" | "rollback"
  amount       Float
  currency     String   @default("USDT")
  status       String   @default("applied") // applied | rolled_back
  balanceAfter Float
  rawPayload   String?
  createdAt    DateTime @default(now())

  @@unique([vendor, externalTxId])
  @@index([userId])
  @@index([roundId])
}
