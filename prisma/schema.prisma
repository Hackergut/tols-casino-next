// TOLS Gaming Casino + Admin Platform — Unified Prisma Schema
// PostgreSQL datasource. Arrays are stored as JSON strings (kept from the
// SQLite era so application code is unchanged; can move to native Json later).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime uses Supabase's connection pooler (PgBouncer, port 6543) so that
  // serverless functions don't exhaust Postgres connections. Migrations and
  // introspection need a direct, unpooled connection (port 5432) because
  // PgBouncer in transaction mode can't run them — that's `directUrl`.
  // Locally, point both at the same local Postgres.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ORIGINAL MODELS ====================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

